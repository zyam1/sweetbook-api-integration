SWEETBOOK_API_KEY=your_sandbox_api_key_here
SWEETBOOK_API_BASE_URL=https://api-sandbox.sweetbook.com/v1

# MySQL connection string
# 비밀번호에 특수문자가 있으면 URL 인코딩 필요 (예: ! → %21, @ → %40, # → %23)
DATABASE_URL="mysql://user:password@host:3306/sweetpress"

CONTRIBUTOR_JWT_SECRET=your_contributor_jwt_secret_here
