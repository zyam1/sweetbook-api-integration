// SweetPress Prisma Schema
// 참조: PLAN.md §3.2 차별화 기능 + DB 활용 후보

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 사용자 (회원가입/로그인)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects         Project[]
  orders           Order[]
  ownedAnthologies Anthology[]   @relation("AnthologyOwner")
  contributions    Contributor[]
}

// 내가 만든 책 메타 (SweetBook bookUid 매핑)
model Project {
  id           Int      @id @default(autoincrement())
  bookUid      String   @unique
  title        String
  bookSpecUid  String
  status       String   @default("DRAFT") // DRAFT / FINALIZED / ORDERED
  externalRef  String?
  userId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastEditedAt DateTime? @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([status])
  @@index([userId])
}

// 주문 이력 (SweetBook orderUid 매핑)
model Order {
  id                Int      @id @default(autoincrement())
  sweetbookOrderUid String   @unique
  projectId         Int?
  userId            Int?
  externalRef       String?
  status            String   // PAID / CONFIRMED / IN_PRODUCTION / SHIPPED / DELIVERED / CANCELLED
  quantity          Int
  totalAmount       Int
  paidCreditAmount  Int
  recipientName     String?
  trackingNumber    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([externalRef])
  @@index([userId])
}

// 다인 합본 (Anthology)
model Anthology {
  id               Int       @id @default(autoincrement())
  ownerId          Int
  owner            User      @relation("AnthologyOwner", fields: [ownerId], references: [id])
  title            String
  bookSpecUid      String
  description      String?   @db.Text
  coverTemplateUid String?
  coverFrontPhoto  String?
  coverBackPhoto   String?
  invitePasswordHash String?
  deadline         DateTime?
  status           String    @default("RECRUITING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contributors     Contributor[]

  @@index([ownerId])
}

model Contributor {
  id             Int       @id @default(autoincrement())
  anthologyId    Int
  userId         Int?
  handle         String?
  allocatedPages Int       @default(0)
  order          Int       @default(0)
  status         String    @default("PENDING")
  inviteToken    String    @unique
  deadline       DateTime?
  tokenUsedAt    DateTime?
  anthology      Anthology @relation(fields: [anthologyId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])
  submissions    ContributorSubmission[]

  @@index([anthologyId])
  @@index([userId])
}

model ContributorSubmission {
  id            Int         @id @default(autoincrement())
  contributorId Int
  fileName      String
  storedPath    String
  mimeType      String?
  sizeBytes     Int?
  dpi           Int?
  createdAt     DateTime    @default(now())
  contributor   Contributor @relation(fields: [contributorId], references: [id])
}

// 웹훅 이벤트 로그 (멱등 처리용)
model WebhookEvent {
  id          Int      @id @default(autoincrement())
  deliveryId  String   @unique  // X-Webhook-Delivery
  eventType   String              // order.paid / order.shipped / ...
  payload     Json
  processed   Boolean  @default(false)
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@index([eventType])
  @@index([processed])
}
